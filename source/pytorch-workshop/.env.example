# example of file for storing private and user specific environment variables, like keys or system paths
# rename it to ".env" (excluded from version control by default)
# .env is loaded by train.py and eval.py automatically

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Use a fake chat model for testing
USE_FAKE_CHAT_MODEL=false

# Set a default model
DEFAULT_CHAT_MODEL="gpt-4o-mini"

# Web server configuration
HOST=127.0.0.1
PORT=8000

# Authentication secret, HTTP bearer token header is required if set
AUTH_SECRET=

# Langsmith configuration
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Tools configuration
OPENWEATHERMAP_API_KEY=
TAVILY_API_KEY=

# Application mode. If the value is "dev", it will enable uvicorn reload
MODE=
